# Copy outside the repository and replace every CHANGE_ME value.
SERVER_ADDR=127.0.0.1:6365
DB_TYPE=sqlite
DB_PATH=/var/lib/flvx-test/gost.db
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
LOG_DIR=/var/log/flvx-test

# BusinessLine infrastructure IDs from this environment's own database.
FLVX_BUSINESS_LINE_GZ_NODE_ID=CHANGE_ME_GZ_NODE_ID
FLVX_BUSINESS_LINE_FRONTSEA_NODE_ID=CHANGE_ME_FRONTSEA_NODE_ID
FLVX_BUSINESS_LINE_QIX_TUNNEL_ID=CHANGE_ME_QIX_TUNNEL_ID

# Optional. Leave empty to keep passkeys disabled.
FLVX_WEBAUTHN_ORIGIN=
